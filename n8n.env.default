# See: https://docs.n8n.io/hosting/configuration/environment-variables/
N8N_HOST=0.0.0.0
N8N_PORT=5678
# We run as root, not as 'node' user
N8N_USER_FOLDER=/home/root
NODE_ENV=production
TZ=Europe/Amsterdam
GENERIC_TIMEZONE=Europe/Amsterdam
EXECUTIONS_TIMEOUT_MAX=86400
N8N_DIAGNOSTICS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false
# Enable execute command node
NODES_EXCLUDE="[]"