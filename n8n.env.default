# TODO After updating to v2, check logs for deprecations and see what needs changing
N8N_HOST=0.0.0.0
N8N_PORT=5678
# We run as root, not as 'node' user
N8N_USER_FOLDER=/home/root
NODE_ENV=production
TZ=Europe/London
EXECUTIONS_TIMEOUT_MAX=86400
N8N_DIAGNOSTICS_ENABLED=false
N8N_HIRING_BANNER_ENABLED=false