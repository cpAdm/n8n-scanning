{
  "name": "n8n-nodes-ip-ranges-csp",
  "private": "true",
  "version": "0.1.0",
  "description": "Includes N8N action nodes to retrieve IP ranges belonging to certain CSPs and perform scanning.",
  "license": "MIT",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "cpadm"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cpAdm/n8n-scanning.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [],
    "nodes": [
      "dist/nodes/CspIpRanges/CspIpRanges.node.js",
      "dist/nodes/Nmap/Nmap.node.js",
      "dist/nodes/Zmap/Zmap.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^24.10.1",
    "@types/xml2js": "^0.4.14",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*",
    "xml2js": "*"
  }
}
